# Backend (apps/api) configuration. Copy to .env and fill in values.
# .env is gitignored - never commit real secrets.

# --- Required now ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/financial_managed

# --- Auth / Google OAuth (Phase 1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must byte-match an Authorized redirect URI in the Google Cloud OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the OAuth callback sends the browser after login; also an allowed CORS origin.
FRONTEND_URL=http://localhost:3000
# Random 32+ byte string; signs the short-lived OAuth state cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Comma-separated allowlist of the Google account emails permitted to sign in.
# Empty => nobody can sign in (fail closed).
ALLOWED_GOOGLE_EMAILS=
# Set false for local HTTP dev; leave true (default) in production over HTTPS.
COOKIE_SECURE=false
# Optional session tunables (defaults shown) - uncomment only to override:
# SESSION_TTL_HOURS=720
# SESSION_COOKIE_NAME=fm_session
# OAUTH_COOKIE_NAME=fm_oauth

# --- Reserved for later phases (Financial AI - Phase 9) ---
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=

# --- Reserved for later phases (Telegram - Phase 11) ---
TELEGRAM_BOT_TOKEN=

# --- Reserved for later phases (document ingestion / object storage) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Reserved for later phases (async worker / job queue) ---
REDIS_URL=
