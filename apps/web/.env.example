# Required now: base URL of the FastAPI backend. Read server-side only
# (Server Components), so it can be overridden per-environment (local dev,
# docker-compose, production) without rebuilding the app.
API_URL=http://localhost:8000

# Optional: must match the API's SESSION_COOKIE_NAME if that is ever
# overridden from its default (see .env.example at the repo root). Only
# uncomment if you change it there too.
# SESSION_COOKIE_NAME=fm_session
